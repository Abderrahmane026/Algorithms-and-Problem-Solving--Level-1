int ReadPositiveNumber(string Message)
{
	int Number;

	do
	{
		cout << Message << endl;
		cin >> Number;

	} while (Number < 0);

	return Number;
}
int FactorialOfN(int N)
{
	int factorial = 1;
	int counter = N;

	do
	{
		factorial = factorial * counter;
		counter--;
	} while (counter != 1);

	return factorial;
}

