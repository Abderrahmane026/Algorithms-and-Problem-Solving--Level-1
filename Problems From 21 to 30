float ReadCircumference()
{
	float Circumference;

	cout << "Enter circumference l : ";
	cin >> Circumference;

	return Circumference;
}
float CalculateCircleAreaByCircumference(float l)
{
	const float PI = 3.14159265358979;

	float Area = (pow(l, 2) * PI) / 4;

	return Area;
}
void PrintCircumferenceArea(float Area)
{
	cout << "Circle area by circumference : " << Area << endl;
}

void ReadTriangleData(float& a, float& b)
{
	cout << "\nEnter triangle side a : ";
	cin >> a;

	cout << "Enter triangle base b : ";
	cin >> b;
}
float CalculateCircleAreaByTriangle(float a, float b)
{
	const float PI = 3.14159265358979;
	float Area = Area = PI * (pow(b, 2) / 4) * ((2 * a - b) / (2 * a + b));
	return Area;
}
void PrintCircleAreaByTriangle(float Area)
{
	cout << "Circle area inscribed in an isosceles triangle by circumference : " << Area << endl;
}

void ReadTriangleData(float& a, float& b, float& c)
{
	cout << "\nEnter triangle side a : ";
	cin >> a;

	cout << "Enter triangle base b : ";
	cin >> b;

	cout << "Enter triangle side c : ";
	cin >> c;
}
float CalculateCircleAreaByTriangle(float a, float b, float c)
{
	const float PI = 3.14159265358979;

	float P = (a + b + c) / 2;
	float T = (a * b * c) / (4 * sqrt(P * (P - a) * (P - b) * (P - c)));

	float Area = Area = PI * pow(T, 2);
	return Area;
}

short ReadAge()
{
	short Age;
	
	cout << "\nEnter your age : ";
	cin >> Age;

	return Age;
}
bool ValidateNumberInRange(short Age, short From, short To)
{
	return (Age >= From && Age <= To);
}
void PrintResult(short Age)
{
	if (ValidateNumberInRange(Age, 18, 45))
		cout << Age << " is a valid age" << endl;
	else
		cout << Age << " is invalid age" << endl;
}

short ReadUntilAgeBetween(short From, short To)
{
	short Age = 0;

	do
	{
		Age = ReadAge();
	} while (!ValidateNumberInRange(Age, From, To));

	return Age;
}

int ReadNumber()
{
	int N;

	cout << "\nEnter number : ";
	cin >> N;

	return N;
}
void PrintNumberFrom1ToN_UsingWhile(int N)
{
	int counter = 1;

	cout << "Range printed using while statment : \n";

	while (counter <= N)
	{
		cout << counter << endl;
		counter++;
	}
}
void PrintNumberFrom1ToN_UsingDoWhile(int N)
{
	int counter = 1;

	cout << "Range printed using do while statment : \n";

	do
	{
		cout << counter << endl;
		counter++;

	} while (counter <= N);
}
void PrintNumberFrom1ToN_UsingFor(int N)
{
	cout << "Range printed using for statment : \n";

	for (int counter = 1; counter <= N; counter++)
		cout << counter << endl;
}

void PrintNumberFromNTo1_UsingWhile(int N)
{
	int counter = N;

	cout << "Range printed using while statment : \n";

	while (counter >= 1)
	{
		cout << counter << endl;
		counter--;
	}
}
void PrintNumberFromNTo1_UsingDoWhile(int N)
{
	int counter = N;

	cout << "Range printed using do while statment : \n";

	do
	{
		cout << counter << endl;
		counter--;

	} while (counter >= 1);
}
void PrintNumberFromNTo1_UsingFor(int N)
{
	cout << "Range printed using for statment : \n";

	for (int counter = N; counter >= 1; counter--)
		cout << counter << endl;
}

enum enNumberType { Odd = 0, Even = 1 };
enNumberType CheckNumberIfOddOrEven(int Number)
{
	if (Number % 2 == 0)
		return enNumberType::Even;
	else
		return enNumberType::Odd;
}

int SumOddNumberFrom1ToN_UsingWhile(int N)
{
	int counter = 1;
	int Sum = 0;

	cout << "Sum odd numbers using while statment : \n";

	while (counter <= N)
	{
		if (CheckNumberIfOddOrEven(counter) == enNumberType::Odd)
			Sum += counter;
		counter++;
	}

	return Sum;
}
