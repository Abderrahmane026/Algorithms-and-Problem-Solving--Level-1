enum enOperationType
{
	Add = '+', Subtract = '-', Multiply = '*', Divide = '/'
};
float ReadNumber(string Message)
{
	float Number = 0;

	cout << Message;
	cin >> Number;

	return Number;
}
enOperationType ReadOperationType()
{
	char OperationType = '+';

	cout << "Enter operation type (+, -, *, /) : ";
	cin >> OperationType;

	return (enOperationType)OperationType;
}
float Calculation(float Number1, float Number2, enOperationType Operation)
{
	switch (Operation)
	{
		case enOperationType::Add:
			return float(Number1 + Number2);
		case enOperationType::Subtract:
			return float(Number1 - Number2);
		case enOperationType::Multiply:
			return float(Number1 * Number2);
		case enOperationType::Divide:
			return float(Number1 / Number2);
		default:
			return Number1 + Number2;
	}
}
void PrintCalculationResult(float Result)
{
	cout << "Result : " << Result << endl;
}

int SumNumbers()
{
	int Number, Counter = 1, sum = 0;

	do
	{
		Number = ReadNumber("\nEnter number " + to_string(Counter) + " : ");

		if (Number == -99)
			break;

		sum += Number;
		Counter++;

	} while (Number != -99);
	return sum;
}
void PrintSumAllNumberUntil99(int Sum)
{
	cout << "Result : " << Sum << endl;
}

enum enPrimeNotPrime
{
	Prime = 0, NotPrime = 1
};
enPrimeNotPrime CheckPrimeNumber(int Number)
{
	int M = round(Number / 2);

	for (int counter = 2; counter <= M; counter++)
	{
		if (Number % counter == 0)
			return enPrimeNotPrime::NotPrime;
	}
	return enPrimeNotPrime::Prime;
}
float ReadPositiveNumber(string Message)
{
	float Number;

	do
	{
		cout << Message;
		cin >> Number;

	} while (Number < 0);

	return Number;
}
void PrintNumberType(int Number)	
{
	switch (CheckPrimeNumber(Number))
	{
	case enPrimeNotPrime::Prime:
		cout << "Prime number!" << endl;
		break;
	case enPrimeNotPrime::NotPrime:
		cout << "Not prime number!" << endl;
		break;
	}
}

float CalculateRemainder(float TotalBill, float CashPaid)
{
	float Remainder = CashPaid - TotalBill;
	return Remainder;
}

float TotalBillAfterServiceAndTax(float TotalBill)
{
	TotalBill = TotalBill * 1.1;
	TotalBill = TotalBill * 1.16;

	return TotalBill;
}

