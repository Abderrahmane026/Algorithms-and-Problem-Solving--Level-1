void PowerOf2_3_4(int Number)
{
	cout << "Power of 2 : " << Number * Number << endl;
	cout << "Power of 3 : " << Number * Number * Number << endl;
	cout << "Power of 4 : " << Number * Number * Number * Number << endl;
}

