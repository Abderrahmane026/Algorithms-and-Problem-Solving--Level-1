float ReadNumberOfHours()
{
	int Hours = 0;

	cout << "Enter number of hours : ";
	cin >> Hours;

	return Hours;
}
float HoursToDays(float Hours)
{
	float Days = Hours / 24;
	return Days;
}
float HoursToWeeks(float Hours)
{
	//float Weeks = Hours / (24 * 7);
	float Weeks = Hours / 24 / 7;
	return Weeks;
}
float DaysToWeeks(float Days)
{
	float Weeks = Days / 7;
	return Weeks;
}


struct stTaskDuration
{
	short Day = 0;
	short Hour = 0;
	short Minute = 0;
	short Second = 0;
};
stTaskDuration ReadTaskDuration()
{
	stTaskDuration TaskDuration;

	cout << "\nEnter number of days : ";
	cin >> TaskDuration.Day;

	cout << "Enter number of Hours : ";
	cin >> TaskDuration.Hour;

	cout << "Enter number of Minutes : ";
	cin >> TaskDuration.Minute;

	cout << "Enter number of Seconds : ";
	cin >> TaskDuration.Second;

	return TaskDuration;
}
float TaskDurationInSecond(stTaskDuration TaskDuration)
{
	float DurationInSeconds = 0;

	DurationInSeconds = TaskDuration.Day * 24 * 60 * 60;
	DurationInSeconds += TaskDuration.Hour * 60 * 60;
	DurationInSeconds += TaskDuration.Minute * 60;
	DurationInSeconds += TaskDuration.Second;

	return DurationInSeconds;
}
void PrintTaskDurationOnSecond(float TaskDurationOnSecond)
{
	cout << "Task duration in seconds : " << TaskDurationOnSecond << " second." << endl;
}


int ReadNumberOfSecond()
{
	int NumberOfSecond = 0;

	cout << "\nEnter number of seconds : ";
	cin >> NumberOfSecond;

	return NumberOfSecond;
}
stTaskDuration SecondsToTaskDuration(int NumberOfSecond)
{
	stTaskDuration TaskDuraiton;

	const int SecondPerDay = 24 * 60 * 60;
	const int SecondPerHour = 60 * 60;
	const int SecondPerMinute = 60;
	int Remainder = 0;

	TaskDuraiton.Day = floor(NumberOfSecond / SecondPerDay);
	Remainder = NumberOfSecond % SecondPerDay;

	TaskDuraiton.Hour = floor(Remainder / SecondPerHour);
	Remainder = Remainder % SecondPerHour;

	TaskDuraiton.Minute = floor(Remainder / SecondPerMinute);
	Remainder = Remainder % SecondPerMinute;

	TaskDuraiton.Second = Remainder;

	return TaskDuraiton;
}
void PrintTaskDurationDetails(stTaskDuration TaskDuration)
{
	cout << TaskDuration.Day << ":" << TaskDuration.Hour << ":" << TaskDuration.Minute << ":" << TaskDuration.Second << endl;
}


enum enDaysOfWeek {Sat = 1, Sun = 2, Mon = 3, Tue = 4, Wed = 5, Thu = 6, Fri = 7};
short ReadDayInRange(string Message, short From, short To)
{
	short Day = -1;

	while (Day < From || Day > To)
	{
		cout << Message;
		cin >> Day;
	}
	
	return Day;
}
enDaysOfWeek ReadDayOfWeek()
{
	return (enDaysOfWeek)ReadDayInRange("\nEnter day [Sat = 1, Sun = 2, Mon = 3, Tue = 4, Wed = 5, Thu = 6, Fri = 7] : ", 1, 7);
}
string GetDayOfWeek(enDaysOfWeek Day)
{
	switch (Day)
	{
	case enDaysOfWeek::Sun:
		return "Sunday";
	case enDaysOfWeek::Mon:
		return "Monday";
	case enDaysOfWeek::Tue:
		return "Tuesday";
	case enDaysOfWeek::Wed:
		return "Wednesday";
	case enDaysOfWeek::Thu:
		return "Thursday";
	case enDaysOfWeek::Fri:
		return "Friday";
	case enDaysOfWeek::Sat:
		return "Saturday";
	}
}


